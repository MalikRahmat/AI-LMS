FLASK_ENV=development
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-another-long-random-string

# MySQL (local). Leave empty to fall back to SQLite for quick testing.
DATABASE_URL=mysql+pymysql://root:ailearn123@localhost:3306/ai_learning

CORS_ORIGINS=http://localhost:5173

# ---- LLM (OpenAI-compatible). Pick ONE provider ----
# Free: Groq  -> https://console.groq.com  (free API key)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Free: Google Gemini (OpenAI-compatible)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# TensorFlow (optional, needs requirements-tf.txt)
USE_TENSORFLOW=false

# Storage: leave GCS_BUCKET empty to store files locally in backend/instance/uploads
GCS_BUCKET=

# Integrations (optional)
MOODLE_URL=
MOODLE_TOKEN=
